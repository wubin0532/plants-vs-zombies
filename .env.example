# garden-api 可选环境变量。本地开发可直接 export，Docker 部署见 deploy/。
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。

# 监听
PORT=8787
HOST=0.0.0.0

# 数据目录（users.json / saves/ / secret.key）
DATA_DIR=./data

# 账号数量上限
MAX_USERS=5

# 通过 HTTPS 访问时必须设为 1；否则浏览器不会保存 Secure Cookie。
COOKIE_SECURE=0

# 仅当本服务只被受信反向代理访问、且端口不对局域网发布时设为 1。
# 开启后按代理覆盖写的 X-Real-IP 计数；否则一律按 TCP 来源地址计数。
TRUST_PROXY=0

# 登录 / 注册限流
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# 存档写入限流（每用户）
SAVE_RATE_LIMIT_MAX=60
