{
  "name": "garden-defense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "assets": "node scripts/prepare-mist.mjs && node scripts/prepare-props.mjs && node scripts/prepare-weather.mjs && node scripts/prepare-presentation.mjs && node scripts/prepare-backgrounds.mjs && node scripts/prepare-assets.mjs && node scripts/prepare-motion.mjs && node scripts/prepare-cards.mjs",
    "assets:cards": "node scripts/prepare-cards.mjs",
    "assets:icons": "node scripts/prepare-icons.mjs",
    "assets:mist": "node scripts/prepare-mist.mjs",
    "assets:weather": "node scripts/prepare-weather.mjs",
    "assets:backgrounds": "node scripts/prepare-backgrounds.mjs",
    "assets:portraits": "node scripts/prepare-assets.mjs",
    "assets:props": "node scripts/prepare-props.mjs",
    "assets:import": "node scripts/import-redraw.mjs",
    "assets:compress": "node scripts/compress-sources.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:assets:strict": "node scripts/verify-assets.mjs --strict",
    "assets:verify": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
